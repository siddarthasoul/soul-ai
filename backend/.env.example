# SOUL AI Backend Environment Variables

# Copy this file to `.env` and replace the placeholder values.

# ============================================================

# APP

# ============================================================

APP_NAME=soulai
NODE_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
COOKIE_SECURE=true

# ============================================================

# SERVER

# ============================================================

HOST=0.0.0.0
PORT=8000

# ============================================================

# DATABASE

# ============================================================

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGO_DB_NAME=soul_data

# ============================================================

# REDIS

# ============================================================

REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_USERNAME=<redis-username>
REDIS_PASSWORD=<redis-password>
REDIS_DB=0
REDIS_TLS=true

# ============================================================

# MAIL

# ============================================================

MAIL_USERNAME=<gmail-address>
MAIL_PASSWORD=<gmail-app-password>
MAIL_FROM=<gmail-address>

MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=SOUL AI

MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ============================================================

# LLM

# ============================================================

# Ollama endpoint.

#

# Local development:

# OLLAMA_HOST=http://host.docker.internal:11434

#

# If Ollama is exposed through a secure tunnel:

# OLLAMA_HOST=https://your-ollama-tunnel.example.com

OLLAMA_HOST=https://your-ollama-host.example.com

LLM_MODEL=qwen3:1.7b
LLM_TIMEOUT=50000

# ============================================================

# OTP

# ============================================================

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

OTP_RATE_LIMIT=3
OTP_RATE_WINDOW_SECONDS=3600

# ============================================================

# SESSION

# ============================================================

SESSION_TTL_SECONDS=2592000

# ============================================================

# GENERAL API RATE LIMIT

# ============================================================

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=50

# ============================================================

# MEMORY

# ============================================================

MAX_MESSAGES=20

# ============================================================

# OTP PROTECTION

# ============================================================

OTP_REQUEST_LIMIT=3
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_VERIFY_ATTEMPT_LIMIT=5

# ============================================================

# CHAT RATE LIMIT

# ============================================================

CHAT_USER_RATE_WINDOW_SECONDS=60
CHAT_USER_RATE_LIMIT=15

CHAT_GUEST_RATE_LIMIT=15
CHAT_GUEST_RATE_WINDOW_SECONDS=60

# ============================================================

# CHAT BURST RATE LIMIT

# ============================================================

CHAT_RATE_LIMIT=3
CHAT_RATE_WINDOW_SECONDS=30

# ============================================================

# FEEDBACK PROTECTION

# ============================================================

FEEDBACK_REQUEST_LIMIT=2
FEEDBACK_REQUEST_WINDOW_SECONDS=86400
